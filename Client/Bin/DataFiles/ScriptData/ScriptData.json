        "NpcScarlet": {
            "szAnimTag": "Default",
            "bCanControl": false,
            "vInitOffset": [
                0.0,
                350.0
            ],
            "szSpeaker": "홍련",
            "Scripts": [
                {
                    "szText": "낭자, 또 만났네?"
                },
                {
                    "szText": "보아하니.."
                },
                {
                    "szText": "다음 장으로 넘어가기엔 준비가 필요해 보이네"
                },
                {
                    "szText": "상점 주인의 조언을 따라보는 것이 어떤가?"
                },
                {
                    "szText": "그럼.. 또 봅세 낭자"
                }
            ]
        },
        "NpcD1G-g2r": {
            "szAnimTag": "Default",
            "bCanControl": false,
            "vInitOffset": [
                0.0,
                350.0
            ],
            "szSpeaker": "D1G-g2r",
            "Scripts": [
                {
                    "szText": "도롱.."
                },
                {
                    "szText": "아니.."
                },
                {
                    "szText": "저는 상점을 운영중인 D1G-g2r입니다."
                },
                {
                    "szText": "구경하고 가세요"
                }
            ]
        },
        "NpcD1G-g2r2": {
            "szAnimTag": "Default",
            "bCanControl": false,
            "vInitOffset": [
                0.0,
                350.0
            ],
            "szSpeaker": "D1G-g2r",
            "Scripts": [
                {
                    "szText": "이용해주셔서 감사합니다."
                },
                {
                    "szText": "혹시.."
                },
                {
                    "szText": "골드가 부족하시다면"
                },
                {
                    "szText": "마을에 있는 도로롱에게 말을 걸어보세요"
                },
                {
                    "szText": "재밌는 일이 일어날지도..?"
                }
            ]
        },
        "NpcD1G-g2r3": {
