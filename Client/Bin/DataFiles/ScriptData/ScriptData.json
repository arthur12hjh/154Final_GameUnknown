{
    "ScriptData": {
        "Loading": {
            "szAnimTag": "Loading",
            "bCanControl": true,
            "Scripts": [
                {
                    "szText": "그럴 리가 없고, 그럴 수도 없다"
                },
                {
                    "szText": "재훈이형처럼 연애합시다",
                    "vColor": [
                        1.0,
                        0.0,
                        0.0,
                        1.0
                    ]
                },
                {
                    "szText": "정의훈쌤! 짱짱맨! >.<"
                },
                {
                    "szText": "재훈햄의 여자친구 흑련과 테무산 이브는 인게임에서 만날수있습니다."
                },
                {
                    "szText": "쥬신에사는 작은 하마는 API 시연회를 지나 SR을 지나 3D개인폴을지나 \n 아직도 작은 장난감을 찾고있습니다 도와주세요."
                }
            ]
        },
        "DoorInteractionScript": {
